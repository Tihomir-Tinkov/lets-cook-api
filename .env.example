# Environment
APP_ENV=development

# Server
APP_API_PORT=8080

# Routes
APP_ROUTES_PREFIX=api
APP_ROUTES_LOGGER_MIDDLEWARE=true

# CORS
APP_API_CORS_ALLOW_ORIGINS=http://localhost:3000

# Database
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASS=password
APP_DB_NAME=cooking_site
APP_DB_SSL_MODE=false
APP_DB_MAX_IDLE_CONNS=10
APP_DB_MAX_OPEN_CONNS=25
APP_DB_CONN_MAX_LIFETIME=0s

# JWT
APP_JWT_SECRET=your-secret-key
APP_JWT_ISSUER=cooking-site-api
APP_JWT_EXPIRATION=24h

# Storage
APP_STORE_PATH=storage

# Logger
APP_LOG_ENCODING=json
APP_LOG_LEVEL=info

# Argon2
APP_ARGON2_MEMORY=65536
APP_ARGON2_ITERATIONS=3
APP_ARGON2_PARALLELISM=4
APP_ARGON2_SALT_LENGTH=16
APP_ARGON2_KEY_LENGTH=32