@baseUrl = http://localhost:8082/api

# 00000000-0000-0000-0000-000000000000
@userId = 00000000-0000-0000-0000-000000000000
@recipeId = 00000000-0000-0000-0000-000000000000
@commentId = 00000000-0000-0000-0000-000000000000
@imageId = 00000000-0000-0000-0000-000000000000

################################
# HEALTHCHECK
################################

### Health check
GET {{baseUrl}}/healthcheck


################################
# AUTH
################################

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "displayName": "Test User",
  "email": "test@example.com",
  "password": "password123"
}


### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}


### Store JWT from login response
@token = {{login.response.body.data.token}}


### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}


################################
# USERS
################################

### Get user by ID
GET {{baseUrl}}/users/{{userId}}


### Update user
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "displayName": "Updated User",
  "email": "updated@example.com",
  "password": "newpassword123"
}


### Delete user
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}


################################
# IMAGES
################################

### Upload image 1
# @name uploadImage1
POST {{baseUrl}}/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="Banica.webp"
Content-Type: image/webp

< ./docs/assets/Banica.webp
--WebAppBoundary--


### Capture image ID 1
@imageId1 = {{uploadImage1.response.body.data}}


### Upload image 2
# @name uploadImage2
POST {{baseUrl}}/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="ShopskaSlata.png"
Content-Type: image/png

< ./docs/assets/ShopskaSlata.png
--WebAppBoundary--


### Capture image ID 2
@imageId2 = {{uploadImage2.response.body.data}}


### Upload image 3
# @name uploadImage3
POST {{baseUrl}}/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="Banica.jpg"
Content-Type: image/jpeg

< ./docs/assets/Banica.jpg
--WebAppBoundary--


### Capture image ID 3
@imageId3 = {{uploadImage3.response.body.data}}


### Get image 1
GET {{baseUrl}}/images/{{imageId1}}


### Try deleting attached image
DELETE {{baseUrl}}/images/{{imageId1}}
Authorization: Bearer {{token}}


################################
# RECIPES
################################

### Get all recipes
GET {{baseUrl}}/recipes


### Create recipe with images
# @name createRecipe
POST {{baseUrl}}/recipes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Spaghetti Carbonara",
  "description": "Classic Italian pasta dish",
  "ingredients": "Pasta, eggs, parmesan, pancetta, pepper",
  "instructions": "Cook pasta. Mix eggs and cheese. Combine everything.",
  "timeMinutes": 30,
  "servings": 4,
  "difficulty": "medium",
  "images": [
    {
      "imageId": "{{imageId1}}",
      "displayOrder": 0
    },
    {
      "imageId": "{{imageId2}}",
      "displayOrder": 1
    }
  ]
}


### Capture recipe ID
@recipeId = {{createRecipe.response.body.data.id}}


### Get recipe by ID (should include images)
GET {{baseUrl}}/recipes/{{recipeId}}


### Update recipe and reorder images
PUT {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Updated Carbonara",
  "description": "Updated description",
  "ingredients": "Updated ingredients",
  "instructions": "Updated instructions",
  "timeMinutes": 35,
  "servings": 5,
  "difficulty": "hard",
  "images": [
    {
      "imageId": "{{imageId2}}",
      "displayOrder": 0
    },
    {
      "imageId": "{{imageId1}}",
      "displayOrder": 1
    },
    {
      "imageId": "{{imageId3}}",
      "displayOrder": 2
    }
  ]
}


### Delete recipe
DELETE {{baseUrl}}/recipes/{{recipeId}}
Authorization: Bearer {{token}}


################################
# COMMENTS
################################

### Get recipe comments
GET {{baseUrl}}/recipes/{{recipeId}}/comments


### Create comment
# @name createComment
POST {{baseUrl}}/recipes/{{recipeId}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "body": "This recipe was amazing!",
  "rating": 5
}


### Get comment
GET {{baseUrl}}/recipes/{{recipeId}}/comments/{{commentId}}


### Update comment
PUT {{baseUrl}}/recipes/{{recipeId}}/comments/{{commentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "body": "Updated review text",
  "rating": 4
}


### Delete comment
DELETE {{baseUrl}}/recipes/{{recipeId}}/comments/{{commentId}}
Authorization: Bearer {{token}}